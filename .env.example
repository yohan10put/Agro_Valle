# Configuración de variables de entorno para AgroValle
# Copia este archivo con el nombre .env y coloca tus valores locales:
# cp .env.example .env

DB_NAME=agrovalle_db
DB_USER=agrovalle_user
DB_PASSWORD=tu_contraseña_aqui
DB_HOST=localhost
DB_PORT=5432

# Correo: False = los correos se muestran en la terminal (desarrollo)
CORREO_SMTP=False
CORREO_HOST=smtp.gmail.com
CORREO_PUERTO=587
CORREO_USUARIO=
CORREO_CLAVE=
CORREO_REMITENTE=AgroValle <no-responder@agrovalle.local>
